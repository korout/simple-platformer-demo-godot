; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Simple Platformer Demo"
config/description="✨ Simple Platformer Demo ✨
😎 - Best for beginners and your first game
🕹️ - Better controls with TouchScreen

The game assets uses Kenney's Pixel Platformer (CC0)"
config/version="v4.5.2"
run/main_scene="uid://dogn5ob1qlnvq"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=60
config/icon="uid://chbnoto6syd5h"

